{
  "name": "dsh-input-list",
  "version": "0.1.1",
  "description": "DSH prompt library and reusable snippets plugin for saving, editing, and inserting prompts from the composer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konglong87/dsh-input-list.git"
  },
  "homepage": "https://github.com/konglong87/dsh-input-list#readme",
  "bugs": {
    "url": "https://github.com/konglong87/dsh-input-list/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "prompt",
    "prompt-template",
    "prompt-library",
    "prompt-manager",
    "saved-prompts",
    "snippets",
    "composer",
    "reusable-content",
    "提示词",
    "常用内容"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "HOST-INTEGRATION.md",
    "PUBLISH.md",
    "CHANGELOG.md",
    "docs",
    "screenshots.json"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  }
}
